# WOCSA CyberRange configuration
# Copy to .env and adjust:   cp .env.example .env

# Compose profiles to start by default.
#   dmz      : public services (corporate site, Juice Shop, DVWA, mail gateway)
#   intranet : internal services + user workstations (VPN only)
#   vpn      : WireGuard VPN gateway
# A workshop can start only what it needs: docker compose --profile dmz up -d
COMPOSE_PROFILES=dmz,intranet,vpn

# IP address the DMZ services and VPN admin UI bind to on the host.
#   127.0.0.1 : local workshops, services reachable from the host only (default)
#   0.0.0.0   : shared lab server, participants connect over the LAN
BIND_IP=127.0.0.1

# --- WireGuard VPN (wg-easy) ---
# Host/IP participants' WireGuard clients connect to.
# For a shared lab server use its LAN IP, e.g. 192.168.1.50
WG_HOST=auto
# UDP port of the WireGuard endpoint (must match the published port)
WG_PORT=51820
# Admin UI credentials (http://$BIND_IP:51821)
# WARNING: the VPN admin UI is a published port, so any foothold in the lab
# (e.g. a pwned DMZ service) can reach it. Use a long random password:
#   openssl rand -base64 18
WG_ADMIN_USER=admin
WG_ADMIN_PASSWORD=
# Split-tunnel networks pushed to clients: the tunnel + the intranet
WG_TUNNEL_CIDR=10.99.0.0/24

# --- Databases ---
DB_ROOT_PASSWORD=rootpass
DB_PASSWORD=p@ssw0rd
# DVWA default difficulty: low, medium, high or impossible
DVWA_SECURITY_LEVEL=low

# --- LinuxServer.io images (dokuwiki, workstations) ---
PUID=1000
PGID=1000
TZ=Etc/UTC